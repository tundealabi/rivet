// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailVerificationContext {
  CHANGE_EMAIL
  PASSWORD_RESET
  SIGN_UP
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PlanTier {
  FREE
  PRO
  TEAM
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

// enum ProjectRole {
//   ADMIN
//   MEMBER
//   VIEWER
// }

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  passwordHash    String    @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  emailVerifications EmailVerification[]
  memberships        OrganizationMember[]
  sessions           Session[]
  createdProjects    Project[]            @relation("ProjectCreator")
  assignedIssues     Issue[]              @relation("IssueAssignee")
  issueActivities    IssueActivity[]      @relation("IssueActivityActor")
  requestedExports   ExportJob[]          @relation("ExportJobRequester")

  @@map("users")
}

model EmailVerification {
  id                String                   @id @default(uuid()) @db.Uuid
  codeHash          String                   @map("code_hash")
  context           EmailVerificationContext
  expiresAt         DateTime                 @map("expires_at")
  attempts          Int                      @default(0)
  resendCount       Int                      @default(0) @map("resend_count")
  resendLockedUntil DateTime?                @map("resend_locked_until")
  lastSentAt        DateTime                 @map("last_sent_at")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, context])
  @@map("email_verifications")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  planTier  PlanTier @default(FREE) @map("plan_tier")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members         OrganizationMember[]
  projects        Project[]
  issues          Issue[]
  issueActivities IssueActivity[]
  exportJobs      ExportJob[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("org_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Project {
  id              String @id @default(uuid()) @db.Uuid
  description     String
  key             String
  name            String
  nextIssueNumber Int    @default(1) @map("next_issue_number")

  createdById    String?      @map("created_by") @db.Uuid
  createdBy      User?        @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  organizationId String       @map("org_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  issues     Issue[]
  exportJobs ExportJob[]

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, key])
  @@unique([organizationId, name])
  @@map("projects")
}

model Issue {
  id          String        @id @default(uuid()) @db.Uuid
  number      Int
  title       String
  description String        @default("")
  priority    IssuePriority @default(MEDIUM)
  status      IssueStatus   @default(TODO)

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  projectId      String       @map("project_id") @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String       @map("org_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activities IssueActivity[]

  @@unique([projectId, number])
  @@index([organizationId])
  @@index([assigneeId])
  @@index([projectId, assigneeId])
  @@map("issues")
}

enum IssueActivityField {
  ASSIGNEE
  DESCRIPTION
  PRIORITY
  STATUS
  TITLE
}

model IssueActivity {
  id        String             @id @default(uuid()) @db.Uuid
  field     IssueActivityField
  fromValue String?            @map("from_value")
  toValue   String?            @map("to_value")

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("IssueActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  issueId String @map("issue_id") @db.Uuid
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  organizationId String       @map("org_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([issueId, createdAt])
  @@index([organizationId])
  @@map("issue_activities")
}

enum ExportJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model ExportJob {
  id     String          @id @default(uuid()) @db.Uuid
  status ExportJobStatus @default(QUEUED)

  projectId        String         @map("project_id") @db.Uuid
  filterStatus     IssueStatus?   @map("filter_status")
  filterPriority   IssuePriority? @map("filter_priority")
  filterAssigneeId String?        @map("filter_assignee_id") @db.Uuid
  filterUnassigned Boolean        @default(false) @map("filter_unassigned")

  objectKey String? @map("object_key")
  error     String?

  idempotencyKey String @map("idempotency_key")

  requestedById  String       @map("requested_by_id") @db.Uuid
  requestedBy    User         @relation("ExportJobRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  organizationId String       @map("org_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, requestedById, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, requestedById, createdAt])
  @@map("export_jobs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("refresh_tokens")
}

model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // frozen at login — audit trail of where the session originated
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // updated on each refresh — reflects current activity
  lastSeenAt DateTime? @map("last_seen_at")
  lastSeenIp String?   @map("last_seen_ip")

  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("sessions")
}

