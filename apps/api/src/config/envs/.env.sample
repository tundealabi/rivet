# APP
APP_CORS_ORIGINS="http://localhost:3000,http://localhost:8090" # CORS origins
APP_NODE_ENV=development # environment (development, production, test) — use production on staging too for Node/Express behavior
APP_ENABLE_DEV_FEATURES= # set to true to enable dev-only features (e.g. API docs, debug routes); leave unset in production
PORT=8090 # port to run the server on

# AUTH
AUTH_USER_ACCESS_TOKEN_EXPIRES_IN="15m" # access token expires in
AUTH_USER_ACCESS_TOKEN_SECRET="secret" # access token secret
AUTH_USER_REFRESH_TOKEN_EXPIRES_IN_DAYS=7 # refresh token expires in days

# CLIENT
CLIENT_WEB_BASE_URL="http://localhost:3000" # public Rivet web app URL; used for emails and deep links

# DB
DATABASE_URL="postgresql://localhost:5432/rivet" # postgres connection string

# REDIS (BullMQ; local docker compose redis)
REDIS_URL="redis://localhost:6379" # Redis connection string

# S3 (MinIO locally; Cloudflare R2 in production — same client, env-based endpoint)
S3_ENDPOINT="http://localhost:9000" # S3 API endpoint (MinIO: http://localhost:9000)
S3_REGION="us-east-1" # S3 region (MinIO: us-east-1; R2: auto)
S3_BUCKET="rivet-exports" # bucket name (created by docker compose minio-init)
S3_ACCESS_KEY="rivet" # access key (MinIO root user)
S3_SECRET_KEY="rivetminio" # secret key (MinIO root password; ≥8 chars)
S3_FORCE_PATH_STYLE=true # path-style URLs (required for MinIO; set false for R2)

# STRIPE
STRIPE_SECRET_KEY="sk_test_placeholder" # Stripe secret key
STRIPE_WEBHOOK_SECRET="whsec_placeholder" # Stripe webhook signing secret
STRIPE_PRICE_PRO_ID="price_placeholder" # Stripe Price id for PRO monthly

# SECURITY
SECURITY_HMAC_PEPPER="secret" # HMAC pepper for short-lived token digests (e.g. email OTP)