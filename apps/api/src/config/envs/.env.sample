# APP
APP_CORS_ORIGINS="http://localhost:3000,http://localhost:8090" # CORS origins
NODE_ENV=development # development | production | test — use production on staging too for Node/Express behavior
APP_ENABLE_DEV_FEATURES= # set to true to enable dev-only features (e.g. API docs, debug routes); leave unset in production
PORT=8090 # port to run the server on

# AUTH
AUTH_USER_ACCESS_TOKEN_EXPIRES_IN="15m" # access token expires in
AUTH_USER_ACCESS_TOKEN_SECRET="secret" # access token secret
AUTH_USER_REFRESH_TOKEN_EXPIRES_IN_DAYS=7 # refresh token expires in days

# CLIENT
CLIENT_WEB_BASE_URL="http://localhost:3000" # public Rivet web app URL; used for emails and deep links

# DB (compose: POSTGRES_USER/PASSWORD/DB = rivet)
DATABASE_URL="postgresql://rivet:rivet@localhost:5432/rivet" # postgres connection string

# OBSERVABILITY
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 # Tempo / collector; Grafana Cloud: https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS= # Grafana Cloud: Authorization=Basic%20<base64(instanceId:token)>; leave empty locally
OTEL_TRACES_SAMPLER=always_on # local default; production: parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG= # ratio when using *traceidratio (0–1); production: 0.1
OTEL_RESOURCE_ATTRIBUTES= # e.g. deployment.environment=production
OTEL_METRICS_REMOTE_WRITE_URL= # Grafana Cloud Prometheus tile: https://prometheus-prod-<region>.grafana.net/api/prom/push
OTEL_METRICS_REMOTE_WRITE_USERNAME= # Grafana Cloud instance id
OTEL_METRICS_REMOTE_WRITE_PASSWORD= # Grafana Cloud token with MetricsPublisher
OTEL_METRICS_BEARER_TOKEN= # if set, GET /metrics requires Authorization: Bearer <token>

# REDIS (BullMQ; local docker compose redis)
REDIS_URL="redis://localhost:6379" # Redis connection string

# S3 (MinIO locally; Backblaze B2 in production — same client, env-based endpoint)
S3_ENDPOINT="http://localhost:9000" # S3 API endpoint (MinIO: http://localhost:9000; B2: https://s3.<region>.backblazeb2.com)
S3_REGION="us-east-1" # S3 region (MinIO: us-east-1; B2: e.g. us-west-004)
S3_BUCKET="rivet-exports" # bucket name (created by docker compose minio-init)
S3_ACCESS_KEY="rivet" # access key (MinIO root user; B2: keyID)
S3_SECRET_KEY="rivetminio" # secret key (MinIO root password; ≥8 chars; B2: applicationKey)
S3_FORCE_PATH_STYLE=true # path-style URLs (true for MinIO/B2)

# STRIPE
STRIPE_SECRET_KEY="sk_test_placeholder" # Stripe secret key
STRIPE_WEBHOOK_SECRET="whsec_placeholder" # Stripe webhook signing secret
STRIPE_PRICE_PRO_ID="price_placeholder" # Stripe Price id for PRO monthly

# SECURITY
SECURITY_HMAC_PEPPER="secret" # HMAC pepper for short-lived token digests (e.g. email OTP)